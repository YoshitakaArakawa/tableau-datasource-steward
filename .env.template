# tableau-datasource-steward の認証設定テンプレート
# Skill を呼び出すプロジェクトの作業ディレクトリ（またはその親）に .env としてコピーし、実値を埋める。
# .env はそのプロジェクトの .gitignore に入れて commit しない。
# 認証は OAuth 2.0 (Authorization Code + PKCE) のブラウザサインイン。静的トークンは持たない。

SERVER=https://<your-tableau-server-host>
SITE_NAME=<your-site-content-url>
OAUTH_CALLBACK_PORT=8765
